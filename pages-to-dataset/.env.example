# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# the pages: a comma-separated list of addresses, or a search query (when URLS is empty)
# URLS=https://example.com/docs/a,https://example.com/docs/b
# QUERY=how do vector databases index embeddings
# passage size, question-answer pairs per page, and the share kept for evaluation
# CHUNK_TOKENS=200
# QA_PER_PAGE=3
# EVAL_SHARE=0.2
# Where the output goes (default: output)
# OUTPUT_DIR=output
