# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# the status pages to watch (at most 10), and your chat's incoming webhook (Slack format)
# PAGES=https://www.githubstatus.com/,https://status.npmjs.org/
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
# where the last state of each page is kept, and how often to check again in this process
# STATE_DIR=output/state
# RUNS=1
# INTERVAL_SECONDS=300
# Where the output goes (default: output)
# OUTPUT_DIR=output
