# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# the product page, and (optionally) candidate pages to compare it with; without them a web search finds some
# PRODUCT_URL=https://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html
# CANDIDATES=https://…,https://…
# where prices are remembered between runs
# STATE_DIR=output/state
# Where the output goes (default: output)
# OUTPUT_DIR=output
