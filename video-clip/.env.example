# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# the video
# VIDEO_URL=https://archive.org/download/BigBuckBunny_328/BigBuckBunny_512kb.mp4
# the clip's length
# CLIP_SECONDS=30
# Where the output goes (default: output)
# OUTPUT_DIR=output
