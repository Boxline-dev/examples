# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# your sign-in page (required)
SIGNIN_URL=https://example.com/login
# your user name or email
# SITE_USERNAME=
# your password (keep it in the environment, never in code)
# SITE_PASSWORD=
# the site's 2FA setup key (base32) or otpauth:// link, as shown when you turn on an authenticator app
# SITE_TOTP_SECRET=
# a saved login that already has details (then the three above are not needed)
# CONTEXT_ID=
# Where the output goes (default: output)
# OUTPUT_DIR=output
