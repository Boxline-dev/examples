# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# the changelog or release notes page (required)
CHANGELOG_URL=https://example.com/changelog
# the cron (UTC)
# SCHEDULE=0 8 * * *
# leave the schedule on at the end
# KEEP_SCHEDULE=1
# your chat's incoming webhook (Slack format: {"text": ...}); new entries are posted there
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
# Where the output goes (default: output)
# OUTPUT_DIR=output
