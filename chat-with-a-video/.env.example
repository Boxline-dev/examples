# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# the subtitles (.srt or .vtt), or a video address yt-dlp can read subtitles from (a video you may download)
# SUBTITLES_URL=https://durian.blender.org/wp-content/content/subtitles/sintel_en.srt
# VIDEO_URL=
# your questions, separated by |
# QUESTIONS=What is the girl looking for?|How does it end for the dragon?
# Where the output goes (default: output)
# OUTPUT_DIR=output
