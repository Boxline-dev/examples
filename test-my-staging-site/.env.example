# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# a repository you may clone (required); for a private one, a read-only token in the address, kept in the environment
REPO_URL=https://github.com/you/your-site.git
# the site its tests check (required); the tests get it as STAGING_URL
STAGING_URL=https://staging.example.com/
# how to run the tests
# TEST_COMMAND=npm test
# Where the output goes (default: output)
# OUTPUT_DIR=output
