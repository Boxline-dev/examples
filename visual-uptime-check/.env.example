# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# the pages, comma-separated
# PAGES=https://books.toscrape.com/,https://quotes.toscrape.com/
# a page that takes longer than this (ms) to load is slow
# SLOW_MS=5000
# the cron (at most every 5 minutes; UTC)
# SCHEDULE=*/15 * * * *
# leave the schedule on at the end
# KEEP_SCHEDULE=1
# Where the output goes (default: output)
# OUTPUT_DIR=output
