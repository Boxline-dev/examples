# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# the pages to watch, separated by commas
# PAGES=https://nodejs.org/en/about/previous-releases,https://www.python.org/downloads/
# where the last facts of each page are kept between runs (keep it to compare with the next run)
# STATE_DIR=output/state
# your chat's incoming webhook (Slack format: {"text": ...}); without it, changes go to output/alerts.md only
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
# check again RUNS times, INTERVAL_SECONDS apart (default: once)
# RUNS=1
# INTERVAL_SECONDS=3600
# Where the output goes (default: output)
# OUTPUT_DIR=output
