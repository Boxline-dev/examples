# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# where to start, which links to follow (a regular expression), and how many pages at most
# START_URL=https://books.toscrape.com/catalogue/category/books/poetry_23/index.html
# INCLUDE=/catalogue/[^/]+_\d+/index\.html$
# MAX_PAGES=40
# Where the output goes (default: output)
# OUTPUT_DIR=output
