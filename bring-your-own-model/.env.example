# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# your model: an OpenAI-compatible endpoint, its key and the model's name
# MODEL_BASE_URL=https://api.openai.com/v1      (Fireworks: https://api.fireworks.ai/inference/v1, Ollama: http://localhost:11434/v1)
MODEL_API_KEY=your_model_provider_key
# MODEL=gpt-6-luna
# the page to read
# PAGE_URL=https://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html
# Where the output goes (default: output)
# OUTPUT_DIR=output
