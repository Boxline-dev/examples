# Your Boxline API key (console → API keys). Keep keys out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# your Anthropic key
ANTHROPIC_API_KEY=sk-ant-your-key
# a Claude model with the computer tool
# CUA_MODEL=claude-sonnet-5
# the page the loop opens first
# START_URL=https://books.toscrape.com/
# your own task
# TASK=
# Where the output goes (default: output)
# OUTPUT_DIR=output
