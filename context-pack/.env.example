# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# the pages to pack (at most 10), the question to focus on, and the token budget
# URLS=https://developer.mozilla.org/en-US/docs/Web/HTTP/Guides/Caching
# QUESTION=When does a browser revalidate a cached response?
# BUDGET=1500
# Where the output goes (default: output)
# OUTPUT_DIR=output
