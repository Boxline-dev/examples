# Your API key (console → API keys). Keep it out of code and shared logs.
BOXLINE_API_KEY=bxl_your_key
# Another API than https://api.boxline.dev, e.g. a local one:
# BOXLINE_API_URL=http://localhost:8080
# topics: a story is kept when its title has one of these words (comma-separated); EXCLUDE drops stories
# INCLUDE=ai,llm,agent,agents,browser,security,database,open source
# EXCLUDE=
# how many stories go into the digest (at most 10), and how old they may be
# TOP=5
# MAX_AGE_HOURS=48
# where the stories come from: Hacker News' search API, and RSS or Atom feeds (comma-separated)
# HN_URL=https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=50
# FEEDS=https://github.blog/feed/,https://aws.amazon.com/blogs/aws/feed/
# your chat's incoming webhook (Slack format: {"text": ...})
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
# Where the output goes (default: output)
# OUTPUT_DIR=output
