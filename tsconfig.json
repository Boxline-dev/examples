{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "*/node/*.ts",
    "*/check.ts",
    "runner/check-lib.ts",
    "integrations/*/check.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/.venv",
    "**/output"
  ]
}
